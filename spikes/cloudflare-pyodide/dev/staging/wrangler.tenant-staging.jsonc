{
  // Local workerd staging harness: the same supervisor code and the same
  // workerd runtime as the deployed Worker, but pointed at a real Bifrost API.
  // Not a deployed-Cloudflare claim.
  "name": "bifrost-tenant-staging-local",
  "main": "../tenant-workers/tenant-entry.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["python_workers"],
  "worker_loaders": [{"binding": "LOADER"}],
  // TenantHost is reached through ctx.exports; the binding keeps the class
  // registered for local workerd.
  "durable_objects": {
    "bindings": [{"name": "TENANT_HOST", "class_name": "TenantHost"}]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["RunTokenBroker"]},
    {"tag": "v2", "new_sqlite_classes": ["TenantHost"], "deleted_classes": ["RunTokenBroker"]}
  ],
  "vars": {
    "LOCAL_PROBE": "true",
    "BIFROST_TENANT_LINGER_SECONDS": "90",
    "API_ORIGIN": "https://bifrost-stage.midtowntg.com"
  },
  "observability": {"enabled": false}
}
